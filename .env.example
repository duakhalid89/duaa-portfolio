# Copy to .env (local) and set the same names in Vercel > Project > Settings > Environment Variables
# Chatbot: a free Google Gemini key (aistudio.google.com/apikey) runs both the answers and the embeddings.
GEMINI_API_KEY=
# Optional alternative LLM: used only when GEMINI_API_KEY is empty.
ANTHROPIC_API_KEY=
# Optional: force an embeddings provider (gemini | voyage | openai | local) and its key. Defaults to gemini when GEMINI_API_KEY is set.
EMBEDDINGS_PROVIDER=
EMBEDDINGS_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_TO=kduaa0791@gmail.com
